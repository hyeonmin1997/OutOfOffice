# Export these in your shell (this app does not load .env automatically):
#   set -a; source .env; set +a
# Defaults below are used when a variable is unset.

# Local Ollama server (OpenAI-compatible endpoint). No key needed.
LLM_CHAT_URL=http://localhost:11434/v1/chat/completions
LLM_MODEL=qwen2.5:3b

# Only for a remote HTTPS endpoint; leave empty for local Ollama.
LLM_API_KEY=

# Optional: sampling temperature (provider default if empty) and timeout in seconds.
LLM_TEMPERATURE=
LLM_TIMEOUT=
